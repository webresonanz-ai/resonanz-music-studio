<IfModule mod_headers.c>
    Header always set Content-Security-Policy "script-src 'self' 'unsafe-eval' https://app.sandbox.midtrans.com;"
</IfModule>

RewriteEngine On

# Serve existing files and directories directly (images, assets, uploads, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else to index.php (use relative path for shared hosting)
RewriteRule ^(.*)$ index.php [QSA,L]